# RunPod Worker – Aurora GPU Inference
# Basis: offizielles RunPod PyTorch Image mit CUDA

FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

WORKDIR /app

# Abhängigkeiten
COPY requirements_runpod.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements_runpod.txt

# Aurora Checkpoint (805 MB – liegt lokal neben dieser Dockerfile)
COPY aurora_checkpoint.pt .

# Handler
COPY handler.py .

ENV AURORA_MODEL_PATH=/app/aurora_checkpoint.pt
ENV PYTHONUNBUFFERED=1

# RunPod startet den Handler automatisch
CMD ["python", "-u", "handler.py"]
